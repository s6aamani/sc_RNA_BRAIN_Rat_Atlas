// ── Nextflow config: rat brain atlas pipeline ─────────────────────────────────

nextflow.enable.dsl = 2
def repoRoot = new File(baseDir).parentFile.absolutePath

// ── Parameters ────────────────────────────────────────────────────────────────
params {
    fastq_dir       = System.getenv('FASTQ_DIR') ?: "${repoRoot}/External/fastqs"
    ref_dir         = System.getenv('RAT_REF_DIR') ?: "${repoRoot}/External/rat_ref/mRatBN7.2"
    cellranger_dir  = System.getenv('CELLRANGER_OUT_DIR') ?: "${repoRoot}/Analysis/cellranger"
    data_dir        = System.getenv('SEURAT_DATA_DIR') ?: "${repoRoot}/Data/rat19"
    results_dir     = System.getenv('SEURAT_RESULTS_DIR') ?: "${repoRoot}/Results/rat19"
    cellranger      = System.getenv('CELLRANGER_BIN') ?: "${repoRoot}/opt/cellranger-10.0.0/cellranger"
    sample_id       = "rat19"
    // comma-separated list — CellRanger merges technical replicates automatically
    samples         = "c-Li19-sal-sal,d-Li19-sal-sal"
}

// ── SLURM executor ────────────────────────────────────────────────────────────
process {
    executor    = 'slurm'
    queue       = 'normal'
    clusterOptions = ''

    withName: CELLRANGER_COUNT {
        cpus   = 16
        memory = '64 GB'
        time   = '8h'
    }
    withName: SEURAT_ANALYSIS {
        cpus          = 4
        memory        = '32 GB'
        time          = '2h'
        beforeScript  = 'module load openjdk R-src/4.4.2'
    }
}

// ── Work directory ────────────────────────────────────────────────────────────
workDir = System.getenv('NXF_WORK_DIR') ?: "${repoRoot}/Analysis/nextflow_work"

// ── Execution report ──────────────────────────────────────────────────────────
report {
    enabled = true
    file    = "${params.results_dir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file    = "${params.results_dir}/pipeline_timeline.html"
    overwrite = true
}
