// ── Nextflow config: rat brain atlas pipeline ─────────────────────────────────

nextflow.enable.dsl = 2

// ── Parameters ────────────────────────────────────────────────────────────────
params {
    fastq_dir       = "/masc_shared/ag_maj/dasmeh/P2024065NOS"
    ref_dir         = "/masc_shared/ag_maj/sc_RNA_BRAIN_Rat_Atlas/External/rat_ref"
    data_dir        = "/masc_shared/ag_maj/sc_RNA_BRAIN_Rat_Atlas/Data/rat19"
    results_dir     = "/masc_shared/ag_maj/sc_RNA_BRAIN_Rat_Atlas/Results/rat19"
    cellranger      = "/masc_shared/ag_maj/sc_RNA_BRAIN_Rat_Atlas/opt/cellranger-10.0.0/cellranger"
    ensembl_release = "112"
    sample_id       = "rat19"
    // comma-separated list — CellRanger merges technical replicates automatically
    samples         = "c-Li19-sal-sal,d-Li19-sal-sal"
}

// ── SLURM executor ────────────────────────────────────────────────────────────
process {
    executor    = 'slurm'
    queue       = 'normal'
    clusterOptions = ''

    withName: BUILD_REF {
        cpus   = 8
        memory = '64 GB'
        time   = '6h'
    }
    withName: CELLRANGER_COUNT {
        cpus   = 16
        memory = '64 GB'
        time   = '8h'
    }
    withName: SEURAT_ANALYSIS {
        cpus   = 4
        memory = '32 GB'
        time   = '2h'
    }
}

// ── Work directory ────────────────────────────────────────────────────────────
workDir = "/masc_shared/ag_maj/sc_RNA_BRAIN_Rat_Atlas/Analysis/nextflow_work"

// ── Execution report ──────────────────────────────────────────────────────────
report {
    enabled = true
    file    = "/masc_shared/ag_maj/sc_RNA_BRAIN_Rat_Atlas/Results/rat19/pipeline_report.html"
}
