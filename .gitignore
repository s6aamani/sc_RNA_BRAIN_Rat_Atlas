# ── Large data files ──────────────────────────────────────────────────────────
Analysis/*
!Analysis/.gitkeep
Data/*
!Data/.gitkeep
External/*
!External/.gitkeep
Results/*
!Results/.gitkeep

# ── Tools (large binaries) ────────────────────────────────────────────────────
opt/

# ── CellRanger / sequencing ───────────────────────────────────────────────────
*.fastq.gz
*.fastq
*.bam
*.bai
*.vcf
*.bcf

# ── Single-cell data formats ──────────────────────────────────────────────────
*.h5
*.h5ad
*.loom
*.mtx
*.mtx.gz

# ── R ─────────────────────────────────────────────────────────────────────────
*.RData
*.Rhistory
*.Rds
*.rds
.Rproj.user/
Rplot*.png
Rplot*.pdf

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.jupyter/

# ── HPC / SLURM ───────────────────────────────────────────────────────────────
*.out
*.err
slurm-*.out
logs/*
!logs/.gitkeep

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*~
.vscode/
*.code-workspace
.codex
.codex/

# ── Nextflow / workflow runtime ──────────────────────────────────────────────
.nextflow*
Scripts/.nextflow/
Scripts/nextflow
Scripts/timeline-*.html
*.mro
